commit_msg_file="$1"
first_line=$(head -n 1 "$commit_msg_file")

# Merge/revert commits are generated by git and don't follow our convention.
case "$first_line" in
  "Merge "* | "Revert "*) exit 0 ;;
esac

if ! printf '%s' "$first_line" | grep -qE '^(feat|fix|chore|refactor)/.+'; then
  echo ""
  echo "✖ Invalid commit message: \"$first_line\""
  echo ""
  echo "  Expected format: <type>/<description>"
  echo "  where <type> is one of: feat, fix, chore, refactor"
  echo "  Example: feat/add login button"
  echo ""
  exit 1
fi
